# Copy to .env (git-ignored) and fill in. Never commit real values.

# Recommended: a free OpenAlex API key. Without it the daily budget is ten times smaller, group-by gives one page and
# paging stops at 10,000 results (ADR-0004). Set it in the git-ignored .env only.
# OPENALEX_API_KEY=

# Free key of Springer Nature's metadata API (dev.springernature.com): abstracts of 10.1007/, 10.1186/ and 10.1038/ DOIs
# without one. Blank = off. At most NAMETRACKER_TOPUP_SPRINGER_DAILY_CAP (100) requests a UTC day.
# SPRINGER_API_KEY=
# Free CiNii Research application id: abstracts of Japanese journals' articles where CiNii allows them. Blank = off.
# CINII_APPID=

# Institutional route INSTITUTIONAL (indexer): the University of Copenhagen's subscriber text-and-data-mining APIs,
# tried after every open route for works without open full text. OFF by default. It may be switched on ONLY after the
# KU library has confirmed in writing which licences permit text and data mining for this use, and whether Garrulus
# counts as research by a research organisation under the EU TDM exception (DSM Directive Art. 3, Danish copyright
# law). The text is closed: spooled, named, purged (only mentions, offsets, short snippets, hashes and the URL kept);
# abstracts obtained this way are never stored; every fetch is audited in institutional_fetch.
# NAMETRACKER_INSTITUTIONAL_ENABLED=false
# Allow-list, comma-separated: ELSEVIER, WILEY. Empty = none.
# NAMETRACKER_INSTITUTIONAL_PUBLISHERS=
# Elsevier TDM (Article Retrieval API, 10.1016/ DOIs): API key, plus the institutional token outside the KU IP range.
# ELSEVIER_API_KEY=
# ELSEVIER_INSTTOKEN=
# Wiley TDM (10.1002/, 10.1111/ DOIs): the client token; Wiley answers PDFs, read by a local GROBID (without its URL
# Wiley is not loaded).
# WILEY_TDM_TOKEN=
# NAMETRACKER_INSTITUTIONAL_GROBID_URL=http://localhost:8070
# Fetches a UTC day per publisher.
# NAMETRACKER_INSTITUTIONAL_ELSEVIER_DAILY_CAP=500
# NAMETRACKER_INSTITUTIONAL_WILEY_DAILY_CAP=500

# Contact address sent to Crossref for its polite pool. Optional; without it Crossref runs in the public pool.
# CROSSREF_MAILTO=

# Master switch of the scheduled harvests (indexer). Off by default; tasks enqueued by hand still run.
# NAMETRACKER_HARVEST_ENABLED=false
# Layered harvesting (indexer): a layer's switch (default true) also stops its handler, so its tasks wait. Crons are
# UTC, six fields, and run only with the master switch on.
# NAMETRACKER_LAYERS_OAI_ENABLED=true
# NAMETRACKER_LAYERS_MAGTECH_ENABLED=true
# NAMETRACKER_LAYERS_EUROPEPMC_ENABLED=true
# NAMETRACKER_LAYERS_BLR_ENABLED=true
# Nightly coverage check of yesterday (layer health, per-journal misses); not behind the master switch.
# NAMETRACKER_LAYERS_COVERAGE_CRON=0 30 6 * * *
# NAMETRACKER_COVERAGE_FAIL_DAYS=2
# NAMETRACKER_COVERAGE_YIELD_RATIO=0.5
# NAMETRACKER_COVERAGE_MISS_SHARE=0.30
# NAMETRACKER_COVERAGE_MISS_BASELINE=0.10
# Zero-yield days that make a layer FAILING (only days with a DONE run whose weekday median yield is at least
# ZERO_YIELD_MIN_EXPECTED); the yield-ratio rule applies from a weekly median of YIELD_MIN_MEDIAN.
# NAMETRACKER_COVERAGE_ZERO_FAIL_DAYS=3
# NAMETRACKER_COVERAGE_ZERO_YIELD_MIN_EXPECTED=3.0
# NAMETRACKER_COVERAGE_YIELD_MIN_MEDIAN=14
# An ONBOARDING/BACKFILL OAI pass that loses its resumption token restarts a day later at most this often.
# NAMETRACKER_LAYERS_OAI_MAX_LONG_RESTARTS=3
# NAMETRACKER_LAYERS_OAI_CRON=0 30 4 * * *
# NAMETRACKER_LAYERS_MAGTECH_CRON=0 45 4 * * *
# NAMETRACKER_LAYERS_EUROPEPMC_CRON=0 0 5 * * *
# NAMETRACKER_LAYERS_BLR_CRON=0 15 5 * * *
# Nightly route rollout: onboarding passes of VERIFIED routes.
# NAMETRACKER_LAYERS_ROLLOUT_CRON=0 30 0 * * *
# NAMETRACKER_LAYERS_ROLLOUT_PER_NIGHT=20

# Shared token for admin endpoints (X-Admin-Token header, scripts). Set a long random value outside local development.
ADMIN_TOKEN=
# ORCID iDs of the admins, comma-separated: their ORCID sign-in opens the admin endpoints in the browser.
# NAMETRACKER_ADMIN_ORCIDS=0000-0002-1825-0097
# Mail of the admin notices (layer failing/recovered, route restart cap) and of the registration mails (UTC cron,
# six fields; "-" switches off). Without spring.mail.host nothing is sent.
# NAMETRACKER_ADMIN_MAIL_CRON=0 */5 * * * *
# NAMETRACKER_REGISTRATIONS_MAIL_CRON=0 */5 * * * *
# NAMETRACKER_REGISTRATIONS_ADMIN_NOTE_CRON=0 0 7 * * *

# Journal registry and discovery (indexer, M6b; ADR-0009). Discovery and sampling run only with the master switch.
# ISSN to ISSN-L table of the ISSN International Centre: OFF until the (undocumented) URL is cleared for use.
# NAMETRACKER_DISCOVERY_ISSNL_ENABLED=false
# NAMETRACKER_DISCOVERY_ISSNL_URL=https://www.issn.org/wp-content/uploads/2014/03/issnltables.zip
# NAMETRACKER_DISCOVERY_DOAJ_ENABLED=true
# NAMETRACKER_DISCOVERY_DOAJ_LCC_CODES=
# NAMETRACKER_DOAJ_BASE_URL=https://doaj.org/api/v4
# NAMETRACKER_DISCOVERY_PKP_BEACON_ENABLED=true
# NAMETRACKER_DISCOVERY_PKP_BEACON_URL=https://dataverse.harvard.edu/api/access/datafile/14084919
# NAMETRACKER_DISCOVERY_PKP_BEACON_INCLUDE=
# NAMETRACKER_DISCOVERY_PKP_BEACON_EXCLUDE=
# Candidate sampling: newest articles through the finder, aggregate only (nothing goes to work).
# NAMETRACKER_CANDIDATES_SAMPLING_ENABLED=true
# NAMETRACKER_CANDIDATES_SAMPLE_CRON=0 30 1 * * *
# NAMETRACKER_CANDIDATES_SAMPLE_PER_NIGHT=200
# Hosts and authorities fetched without the public-address check (a local service in development only; host:port,
# comma-separated). Never list a public site.
# NAMETRACKER_HTTP_TRUSTED_HOSTS=
# Seeding thresholds and topics (OpenAlex topic ids, comma-separated; blank = the 17 built-in).
# NAMETRACKER_SEED_CANDIDATE_MIN_WORKS=10
# NAMETRACKER_SEED_TAXONOMY_TOPICS=

# Local helper services (match the ports published by docker-compose.yml).
GNFINDER_URL=http://localhost:8778
GROBID_URL=http://localhost:8070

# Accounts and alerts (web). Base URL of the SPA, used in links in emails and feeds.
# NAMETRACKER_PUBLIC_URL=http://localhost:5173
# Sender of sign-in links and digests.
# NAMETRACKER_MAIL_FROM=Garrulus <noreply@localhost>
# Outgoing mail: without spring.mail.host nothing is sent ("mail suppressed" in the log). Mailpit for local use
# (docker compose --profile mail up -d mailpit, web UI on http://localhost:8025):
# spring.mail.host=localhost
# spring.mail.port=1025
# Key that signs unsubscribe links. Blank means a random key per start (links break on restart).
# NAMETRACKER_SIGNING_KEY=
# Hourly email digests (UTC cron, six fields; "-" switches them off). Without a mail host none are sent.
# NAMETRACKER_DIGEST_CRON=0 5 * * * *
# Set to true behind HTTPS so the session and XSRF cookies are sent over HTTPS only.
# NAMETRACKER_COOKIE_SECURE=false
# Alert window in days (indexer hits and web feeds).
# NAMETRACKER_HIT_WINDOW_DAYS=90
# ORCID sign-in (public API client "Garrulus"). Without a client id the ORCID button is hidden.
# ORCID_CLIENT_ID=
# ORCID_CLIENT_SECRET=
# ORCID_BASE_URL=https://orcid.org

# Database (defaults match docker-compose.yml). Uncomment to override.
# NAMETRACKER_DB_URL=jdbc:postgresql://localhost:5434/nametracker
# NAMETRACKER_DB_USER=nametracker
# NAMETRACKER_DB_PASSWORD=nametracker

# Machine-translated English titles (local LibreTranslate 1.9.6 with Argos models, e.g.
# `libretranslate --host 127.0.0.1 --port 5055 --load-only zh,ja,ko,ru,uk,ar,fa,th,vi,tr,es,pt,fr,de,it,id,pl,cs,en`).
# Off unless enabled and the url is set.
# NAMETRACKER_TRANSLATION_ENABLED=false
# NAMETRACKER_TRANSLATION_URL=http://127.0.0.1:5055
# NAMETRACKER_TRANSLATION_MODEL=libretranslate-1.9.6/argos
# NAMETRACKER_TRANSLATION_TIMEOUT=30s
