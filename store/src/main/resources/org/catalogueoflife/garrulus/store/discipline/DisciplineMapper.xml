<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.catalogueoflife.garrulus.store.discipline.DisciplineMapper">

  <resultMap id="result" type="org.catalogueoflife.garrulus.store.discipline.Discipline">
    <constructor>
      <arg column="code" javaType="string"/>
      <arg column="label" javaType="string"/>
      <arg column="parent" javaType="string"/>
      <arg column="replaced_by" javaType="string"/>
      <arg column="sort_order" javaType="_int"/>
    </constructor>
  </resultMap>

  <select id="all" resultMap="result">
    SELECT code, label, parent, replaced_by, sort_order FROM discipline ORDER BY sort_order, code
  </select>

  <select id="replacementRows" resultType="map">
    SELECT code, replaced_by FROM discipline WHERE replaced_by IS NOT NULL
  </select>

  <select id="mappings" resultType="map">
    SELECT scheme, external_code, discipline, weight FROM discipline_mapping ORDER BY scheme, external_code, discipline
  </select>

</mapper>
